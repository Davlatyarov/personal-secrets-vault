# ==============================================================================
# Project 4: Personal Secrets Vault (Vaultwarden)
# ==============================================================================
# Security Notice: NEVER commit the production .env file to version control.
# Copy this template to .env and configure strong production parameters.

# Public root URL (Strictly HTTPS required by Web Crypto API)
DOMAIN=https://vault.davlatyarov.uz

# Local host binding port (Reverse proxied by Nginx / HestiaCP on 127.0.0.1)
VAULT_PORT=8088

# ------------------------------------------------------------------------------
# Access Control & Hardening
# ------------------------------------------------------------------------------
# Set to 'true' ONLY during initial account creation, then revert to 'false'.
SIGNUPS_ALLOWED=false
SIGNUPS_VERIFY=false
INVITATIONS_ALLOWED=false
SHOW_PASSWORD_HINT=false

# Argon2id hashed admin token for https://vault.davlatyarov.uz/admin
# Generate using:
#   docker run --rm -i vaultwarden/server:latest /vaultwarden hash
# Example output format: '$argon2id$v=19$m=65536,t=3,p=4$...' (keep in single quotes)
ADMIN_TOKEN=

# ------------------------------------------------------------------------------
# Logging & Auditing
# ------------------------------------------------------------------------------
LOG_LEVEL=info
EXTENDED_LOGGING=true
LOG_FILE=/data/vaultwarden.log

# Real IP preservation behind reverse proxy
IP_HEADER=X-Forwarded-For

# ------------------------------------------------------------------------------
# WebSockets & Web Vault
# ------------------------------------------------------------------------------
WEBSOCKET_ENABLED=true
WEB_VAULT_ENABLED=true

# ------------------------------------------------------------------------------
# Disaster Recovery Backup Encryption Passphrase
# ------------------------------------------------------------------------------
BACKUP_PASSPHRASE=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_GPG_PASSPHRASE
